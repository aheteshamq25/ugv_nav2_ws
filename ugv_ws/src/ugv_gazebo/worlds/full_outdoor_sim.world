<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="full_outdoor_sim">
    <gui>
      <camera name="user_camera">
        <pose>-11.660200 -5.942800 6.053900 0.000000 0.443643 0.352194</pose>
      </camera>
    </gui>
    <scene>
      <ambient>0.3 0.3 0.3 1.0</ambient>
      <grid>false</grid>
      <sky><clouds><speed>4</speed></clouds></sky>
    </scene>

    <physics type='ode'>
      <ode>
        <solver><type>quick</type><iters>1000</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.9 0.9 0.9 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>0.2 0.2 -0.9</direction>
    </light>
    <light type="point" name="light_bulb">
      <cast_shadows>false</cast_shadows>
      <pose>-14 0 5 0 0 0</pose>
      <diffuse>0.3 0.3 0.3 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <attenuation><range>80</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    </light>

    <!-- ===================== BASE TERRAIN / TOWN (from your uploaded file) ===================== -->
    
    <include><uri>model://house_1</uri><name>house_1_a</name><pose>12 9.5 0 0 0 0</pose></include>
    <include><uri>model://house_1</uri><name>house_1_b</name><pose>129.5 46 0 0 0 1.5707</pose></include>
    <include><uri>model://house_2</uri><name>house_2_a</name><pose>30 -8 0 0 0 0</pose></include>
    <include><uri>model://house_2</uri><name>house_2_b</name><pose>158 91 0 0 0 0</pose></include>
    <include><uri>model://house_2</uri><name>house_2_c</name><pose>135 84.8 0 0 0 0</pose></include>
    
    
    <!-- ===================== ROADS ===================== -->
    <road name="main_street">
      <width>7.34</width>
      <point>0 0 0.01</point>
      <point>100 0 0.01</point>
      <point>150 50 0.01</point>
      <point>150 100 0.01</point>
      <point>200 100 0.01</point>
    </road>
    <road name="gas_station_street">
      <width>17</width>
      <point>65 25 0.01</point>
      <point>65 3.66 0.01</point>
    </road>

    <model name="road_boxes">
      <static>true</static>
      <link name="link">
        <collision name="collision_1"><pose>51 0 0 0 0 0</pose><geometry><box><size>102 7.34 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision>
        <collision name="collision_2"><pose>125 25 0 0 0 0.78539</pose><geometry><box><size>72 7.34 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision>
        <collision name="collision_3"><pose>150 75 0 0 0 0</pose><geometry><box><size>7.34 53 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision>
        <collision name="collision_4"><pose>173.5 100 0 0 0 0</pose><geometry><box><size>54.5 7.34 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision>
        <collision name="collision_5"><pose>198 106 0 0 0 0</pose><geometry><box><size>6 5 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision>
      </link>
    </model>

    <!-- ===================== TREES (dense coverage) ===================== -->
    <include><uri>model://oak_tree</uri><name>oak_1</name><static>true</static><pose>-5 10 0 0 0 0</pose></include>
    <include><uri>model://oak_tree</uri><name>oak_2</name><static>true</static><pose>-8 -5 0 0 0 1.0</pose></include>
    <include><uri>model://oak_tree</uri><name>oak_3</name><static>true</static><pose>40 30 0 0 0 0.5</pose></include>
    <include><uri>model://oak_tree</uri><name>oak_4</name><static>true</static><pose>130 15 0 0 0 1.8</pose></include>

    <!-- ===================== ROCKS ===================== -->
    <include><uri>model://rock</uri><name>rock_1</name><static>true</static><pose>10 -8 0 0 0 0</pose></include>
    <include><uri>model://rock</uri><name>rock_2</name><static>true</static><pose>28 -14 0 0.2 0.1 0.5</pose></include>
    <include><uri>model://rock</uri><name>rock_3</name><static>true</static><pose>55 -12 0 0 0 1.2</pose></include>
    <include><uri>model://rock</uri><name>rock_4</name><static>true</static><pose>-3 15 0 0.1 0.2 0</pose></include>
    <include><uri>model://rock</uri><name>rock_5</name><static>true</static><pose>90 18 0 0 0 0.7</pose></include>
    <include><uri>model://rock</uri><name>rock_6</name><static>true</static><pose>108 -6 0 0.3 0 1.5</pose></include>
    <include><uri>model://rock</uri><name>rock_7</name><static>true</static><pose>163 65 0 0 0 0</pose></include>

    <!-- ===================== ROADSIDE STATIC OBSTACLES ===================== -->
    <include><uri>model://construction_barrel</uri><name>barrel_1</name><static>true</static><pose>10 -6 0 0 0 0</pose></include>
    <include><uri>model://construction_barrel</uri><name>barrel_2</name><static>true</static><pose>90 -6 0 0 0 0</pose></include>
    <include><uri>model://construction_cone</uri><name>cone_1</name><static>true</static><pose>15 5 0 0 0 0</pose></include>
    <include><uri>model://construction_cone</uri><name>cone_2</name><static>true</static><pose>15.5 5 0 0 0 0</pose></include>
    <include><uri>model://jersey_barrier</uri><name>barrier_1</name><static>true</static><pose>55 5.5 0 0 0 0</pose></include>
    <include><uri>model://fire_hydrant</uri><name>hydrant_1</name><static>true</static><pose>30 4.5 0 0 0 0</pose></include>

    <!-- ===================== MOVABLE OBJECTS (real mass  the robot can push these) ===================== -->
    <model name="pushable_crate_1">
      <pose>18 -1 0.25 0 0 0</pose>
      <link name="link">
        <inertial><mass>5.0</mass><inertia><ixx>0.2</ixx><iyy>0.2</iyy><izz>0.2</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.5 0.35 0.15 1</ambient></material></visual>
      </link>
    </model>
    <model name="pushable_barrel_1">
      <pose>62 3 0.4 0 0 0</pose>
      <link name="link">
        <inertial><mass>3.0</mass><inertia><ixx>0.15</ixx><iyy>0.15</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.7 0.05 0.05 1</ambient></material></visual>
      </link>
    </model>
    <model name="pushable_ball_1">
      <pose>98 -2 0.3 0 0 0</pose>
      <link name="link">
        <inertial><mass>1.5</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.3</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material><ambient>0.1 0.3 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- ===================== MOVING ACTORS (scripted  test real-time dynamic avoidance) ===================== -->
    <actor name="pedestrian_crossing_1">
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 1.6</size></box></geometry>
          <material><ambient>0.8 0.6 0.1 1</ambient></material></visual>
      </link>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>25 -6 0.8 0 0 1.5707</pose></waypoint>
          <waypoint><time>8</time><pose>25 6 0.8 0 0 1.5707</pose></waypoint>
          <waypoint><time>9</time><pose>25 6 0.8 0 0 -1.5707</pose></waypoint>
          <waypoint><time>17</time><pose>25 -6 0.8 0 0 -1.5707</pose></waypoint>
          <waypoint><time>18</time><pose>25 -6 0.8 0 0 1.5707</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="moving_vehicle_dummy_1">
      <link name="link">
        <collision name="collision"><geometry><box><size>1.8 0.9 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.8 0.9 0.7</size></box></geometry>
          <material><ambient>0.15 0.15 0.6 1</ambient></material></visual>
      </link>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="drive">
          <waypoint><time>0</time><pose>0 0 0.4 0 0 0</pose></waypoint>
          <waypoint><time>15</time><pose>100 0 0.4 0 0 0</pose></waypoint>
          <waypoint><time>18</time><pose>150 50 0.4 0 0 0.785</pose></waypoint>
          <waypoint><time>22</time><pose>150 100 0.4 0 0 1.5707</pose></waypoint>
          <waypoint><time>30</time><pose>200 100 0.4 0 0 0</pose></waypoint>
          <waypoint><time>31</time><pose>0 0 0.4 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
</sdf>