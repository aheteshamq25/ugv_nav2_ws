  <world name="full_outdoor_sim">
    <gui>
      <camera name="user_camera">
        <pose>-11.660200 -5.942800 6.053900 0.000000 0.443643 0.352194</pose>
      </camera>
    </gui>
    <scene>
      <ambient>0.3 0.3 0.3 1.0</ambient>
      <grid>false</grid>
      <sky><clouds><speed>4</speed></clouds></sky>
