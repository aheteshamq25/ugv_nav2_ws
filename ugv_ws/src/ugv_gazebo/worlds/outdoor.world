<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="outdoor_field">
    <include><uri>model://sun</uri></include>

    <!-- Ground plane with a grass-like material instead of warehouse gray -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grass</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ===================== TREES ===================== -->
    <!-- Each tree = brown trunk (cylinder) + green foliage (sphere) in one static model -->

    <model name="tree_1">
      <static>true</static>
      <pose>3.0 2.0 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk_collision">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="trunk_visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.35 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>
        <collision name="foliage_collision">
          <pose>0 0 1.9 0 0 0</pose>
          <geometry><sphere><radius>0.9</radius></sphere></geometry>
        </collision>
        <visual name="foliage_visual">
          <pose>0 0 1.9 0 0 0</pose>
          <geometry><sphere><radius>0.9</radius></sphere></geometry>
          <material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.15 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_2">
      <static>true</static>
      <pose>-2.5 3.5 0 0 0 0.4</pose>
      <link name="link">
        <collision name="trunk_collision">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>1.8</length></cylinder></geometry>
        </collision>
        <visual name="trunk_visual">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>1.8</length></cylinder></geometry>
          <material><ambient>0.35 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>
        <collision name="foliage_collision">
          <pose>0 0 2.3 0 0 0</pose>
          <geometry><sphere><radius>1.1</radius></sphere></geometry>
        </collision>
        <visual name="foliage_visual">
          <pose>0 0 2.3 0 0 0</pose>
          <geometry><sphere><radius>1.1</radius></sphere></geometry>
          <material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.15 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_3">
      <static>true</static>
      <pose>4.5 -3.0 0 0 0 1.2</pose>
      <link name="link">
        <collision name="trunk_collision">
          <pose>0 0 0.7 0 0 0</pose>
          <geometry><cylinder><radius>0.14</radius><length>1.4</length></cylinder></geometry>
        </collision>
        <visual name="trunk_visual">
          <pose>0 0 0.7 0 0 0</pose>
          <geometry><cylinder><radius>0.14</radius><length>1.4</length></cylinder></geometry>
          <material><ambient>0.35 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>
        <collision name="foliage_collision">
          <pose>0 0 1.8 0 0 0</pose>
          <geometry><sphere><radius>0.85</radius></sphere></geometry>
        </collision>
        <visual name="foliage_visual">
          <pose>0 0 1.8 0 0 0</pose>
          <geometry><sphere><radius>0.85</radius></sphere></geometry>
          <material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.15 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_4">
      <static>true</static>
      <pose>-4.0 -2.0 0 0 0 2.1</pose>
      <link name="link">
        <collision name="trunk_collision">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>1.6</length></cylinder></geometry>
        </collision>
        <visual name="trunk_visual">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>1.6</length></cylinder></geometry>
          <material><ambient>0.35 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>
        <collision name="foliage_collision">
          <pose>0 0 2.0 0 0 0</pose>
          <geometry><sphere><radius>0.95</radius></sphere></geometry>
        </collision>
        <visual name="foliage_visual">
          <pose>0 0 2.0 0 0 0</pose>
          <geometry><sphere><radius>0.95</radius></sphere></geometry>
          <material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.15 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== ROCKS ===================== -->
    <!-- Flattened, irregularly-scaled spheres to read as boulders rather than perfect balls -->

    <model name="rock_1">
      <static>true</static>
      <pose>1.2 -1.0 0.2 0.3 0.1 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.35</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.35</radius></sphere></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rock_2">
      <static>true</static>
      <pose>-1.5 1.2 0.15 0.1 0.4 1.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.25</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.25</radius></sphere></geometry>
          <material><ambient>0.42 0.4 0.38 1</ambient><diffuse>0.48 0.45 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rock_3">
      <static>true</static>
      <pose>2.8 1.8 0.25 0.2 0.2 2.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.45</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.45</radius></sphere></geometry>
          <material><ambient>0.38 0.37 0.35 1</ambient><diffuse>0.44 0.43 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rock_cluster_1">
      <static>true</static>
      <pose>-3.0 0.5 0 0 0 0</pose>
      <link name="link">
        <collision name="rock_a_collision">
          <pose>0 0 0.2 0.1 0.1 0</pose>
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </collision>
        <visual name="rock_a_visual">
          <pose>0 0 0.2 0.1 0.1 0</pose>
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
        <collision name="rock_b_collision">
          <pose>0.4 0.2 0.12 0 0.2 0.5</pose>
          <geometry><sphere><radius>0.18</radius></sphere></geometry>
        </collision>
        <visual name="rock_b_visual">
          <pose>0.4 0.2 0.12 0 0.2 0.5</pose>
          <geometry><sphere><radius>0.18</radius></sphere></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== FALLEN LOGS ===================== -->
    <!-- Horizontal cylinders -- long, low obstacles the local costmap/inflation must handle differently than round rocks -->

    <model name="fallen_log_1">
      <static>true</static>
      <pose>0.5 3.0 0.15 1.5708 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.3 0.18 0.08 1</ambient><diffuse>0.35 0.22 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="fallen_log_2">
      <static>true</static>
      <pose>-2.0 -3.0 0.12 1.5708 0 1.1</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.12</radius><length>1.6</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>1.6</length></cylinder></geometry>
          <material><ambient>0.3 0.18 0.08 1</ambient><diffuse>0.35 0.22 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>