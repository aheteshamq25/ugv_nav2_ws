<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="terrain_world">
    <include><uri>model://sun</uri></include>
    <include><uri>model://rolling_terrain</uri></include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ROAD: flat gray strip laid along the flattened corridor (x=0 band) -->
    <model name="road_strip">
      <static>true</static>
      <pose>0 0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3.0 30 0.02</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_1"><static>true</static><pose>4 3 0 0 0 0</pose><link name="link">
      <collision name="trunk_c"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry></collision>
      <visual name="trunk_v"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry><material><ambient>0.35 0.2 0.1 1</ambient></material></visual>
      <collision name="foliage_c"><pose>0 0 1.9 0 0 0</pose><geometry><sphere><radius>0.9</radius></sphere></geometry></collision>
      <visual name="foliage_v"><pose>0 0 1.9 0 0 0</pose><geometry><sphere><radius>0.9</radius></sphere></geometry><material><ambient>0.1 0.4 0.1 1</ambient></material></visual>
    </link></model>

    <model name="tree_2"><static>true</static><pose>-4 4 0 0 0 0.6</pose><link name="link">
      <collision name="trunk_c"><pose>0 0 0.8 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>1.6</length></cylinder></geometry></collision>
      <visual name="trunk_v"><pose>0 0 0.8 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>1.6</length></cylinder></geometry><material><ambient>0.35 0.2 0.1 1</ambient></material></visual>
      <collision name="foliage_c"><pose>0 0 2.0 0 0 0</pose><geometry><sphere><radius>0.95</radius></sphere></geometry></collision>
      <visual name="foliage_v"><pose>0 0 2.0 0 0 0</pose><geometry><sphere><radius>0.95</radius></sphere></geometry><material><ambient>0.1 0.4 0.1 1</ambient></material></visual>
    </link></model>

    <model name="tree_3"><static>true</static><pose>5 -3 0 0 0 1.4</pose><link name="link">
      <collision name="trunk_c"><pose>0 0 0.7 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>1.4</length></cylinder></geometry></collision>
      <visual name="trunk_v"><pose>0 0 0.7 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>1.4</length></cylinder></geometry><material><ambient>0.35 0.2 0.1 1</ambient></material></visual>
      <collision name="foliage_c"><pose>0 0 1.8 0 0 0</pose><geometry><sphere><radius>0.85</radius></sphere></geometry></collision>
      <visual name="foliage_v"><pose>0 0 1.8 0 0 0</pose><geometry><sphere><radius>0.85</radius></sphere></geometry><material><ambient>0.1 0.4 0.1 1</ambient></material></visual>
    </link></model>

    <model name="tree_4"><static>true</static><pose>-5 -2 0 0 0 2.0</pose><link name="link">
      <collision name="trunk_c"><pose>0 0 0.8 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>1.6</length></cylinder></geometry></collision>
      <visual name="trunk_v"><pose>0 0 0.8 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>1.6</length></cylinder></geometry><material><ambient>0.35 0.2 0.1 1</ambient></material></visual>
      <collision name="foliage_c"><pose>0 0 2.0 0 0 0</pose><geometry><sphere><radius>0.95</radius></sphere></geometry></collision>
      <visual name="foliage_v"><pose>0 0 2.0 0 0 0</pose><geometry><sphere><radius>0.95</radius></sphere></geometry><material><ambient>0.1 0.4 0.1 1</ambient></material></visual>
    </link></model>

    <model name="tree_5"><static>true</static><pose>2 5 0 0 0 0.9</pose><link name="link">
      <collision name="trunk_c"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry></collision>
      <visual name="trunk_v"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry><material><ambient>0.35 0.2 0.1 1</ambient></material></visual>
      <collision name="foliage_c"><pose>0 0 1.9 0 0 0</pose><geometry><sphere><radius>0.9</radius></sphere></geometry></collision>
      <visual name="foliage_v"><pose>0 0 1.9 0 0 0</pose><geometry><sphere><radius>0.9</radius></sphere></geometry><material><ambient>0.1 0.4 0.1 1</ambient></material></visual>
    </link></model>

    <model name="tree_6"><static>true</static><pose>-3 -5 0 0 0 2.5</pose><link name="link">
      <collision name="trunk_c"><pose>0 0 0.7 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>1.4</length></cylinder></geometry></collision>
      <visual name="trunk_v"><pose>0 0 0.7 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>1.4</length></cylinder></geometry><material><ambient>0.35 0.2 0.1 1</ambient></material></visual>
      <collision name="foliage_c"><pose>0 0 1.8 0 0 0</pose><geometry><sphere><radius>0.85</radius></sphere></geometry></collision>
      <visual name="foliage_v"><pose>0 0 1.8 0 0 0</pose><geometry><sphere><radius>0.85</radius></sphere></geometry><material><ambient>0.1 0.4 0.1 1</ambient></material></visual>
    </link></model>

    <!-- ROCKS -->
    <model name="rock_1"><static>true</static><pose>3.5 -1 0.3 0.3 0.1 0.5</pose><link name="link">
      <collision name="c"><geometry><sphere><radius>0.4</radius></sphere></geometry></collision>
      <visual name="v"><geometry><sphere><radius>0.4</radius></sphere></geometry><material><ambient>0.4 0.4 0.4 1</ambient></material></visual>
    </link></model>
    <model name="rock_2"><static>true</static><pose>-2 2.5 0.25 0.1 0.4 1.0</pose><link name="link">
      <collision name="c"><geometry><sphere><radius>0.35</radius></sphere></geometry></collision>
      <visual name="v"><geometry><sphere><radius>0.35</radius></sphere></geometry><material><ambient>0.38 0.37 0.35 1</ambient></material></visual>
    </link></model>
    <model name="rock_3"><static>true</static><pose>1 -4 0.28 0.2 0.2 2.3</pose><link name="link">
      <collision name="c"><geometry><sphere><radius>0.42</radius></sphere></geometry></collision>
      <visual name="v"><geometry><sphere><radius>0.42</radius></sphere></geometry><material><ambient>0.4 0.4 0.4 1</ambient></material></visual>
    </link></model>

  </world>
</sdf>